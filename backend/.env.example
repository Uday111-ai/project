# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Postgres connection string.
# Local dev default (matches app/database.py fallback):
#   postgresql://postgres:postgres@localhost:5432/ai_auth_demo
# On Render, use the "Internal Database URL" from your Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_auth_demo

# URL of the deployed/local frontend, used to build the password-reset and
# email-verification links.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (CORS).
# Include both your local dev frontend and the deployed frontend URL.
CORS_ORIGINS=http://localhost:3000

# SMTP settings for sending password-reset and verification emails.
# For Gmail, use an App Password (not your account password):
# https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Feature / policy toggles -------------------------------------------

# If true (default), accounts must click the emailed verification link
# before they can log in. Set to false only if that friction is
# unacceptable for your product — see README for the trade-off.
REQUIRE_EMAIL_VERIFICATION=true

# Per-account brute-force lockout, in addition to the existing per-IP rate
# limits. After this many consecutive failed logins, the account is
# locked for ACCOUNT_LOCKOUT_DURATION_MINUTES.
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# If true, signup and password-reset check the new password against the
# HaveIBeenPwned breached-password list (k-anonymity API — only a 5-char
# hash prefix is sent, never the password). Off by default: it's a live
# network call on the request path, and some environments can't reach it.
CHECK_PASSWORD_PWNED=false

# Dev/test convenience: auto-create tables on startup instead of requiring
# `alembic upgrade head` first. Leave true for local dev; render.yaml sets
# this to false in production, where Alembic owns the schema.
DB_AUTO_CREATE_TABLES=true
