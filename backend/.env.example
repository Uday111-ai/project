# Copy this file to .env and fill in real values. Never commit .env.

# Secret used to sign JWTs. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Postgres connection string.
# Local dev default (matches app/database.py fallback):
#   postgresql://postgres:postgres@localhost:5432/ai_auth_demo
# On Render, use the "Internal Database URL" from your Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_auth_demo

# URL of the deployed/local frontend, used to build the password-reset link.
FRONTEND_URL=http://localhost:3000

# Comma-separated list of origins allowed to call this API (CORS).
# Include both your local dev frontend and the deployed frontend URL.
CORS_ORIGINS=http://localhost:3000

# SMTP settings for sending password-reset emails.
# For Gmail, use an App Password (not your account password):
# https://myaccount.google.com/apppasswords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
